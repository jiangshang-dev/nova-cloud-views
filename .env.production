# 是否启用 mock
VITE_USE_MOCK = false

# 发布路径（可按部署目录调整，如 /admin/）
VITE_PUBLIC_PATH = /

# 是否启用 gzip 或 brotli 压缩：gzip | brotli | none
VITE_BUILD_COMPRESS = 'gzip'

# 使用压缩时是否删除原始文件
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# 后台接口父地址（生产环境一般同域反代到网关）
VITE_GLOB_API_URL=/api

# 后台接口全路径地址（生产域名，按实际替换）
VITE_GLOB_DOMAIN_URL=https://api.example.com

# 接口父路径前缀
VITE_GLOB_API_URL_PREFIX=

# icon：online | local
VITE_GLOB_ICONIFY_USE_TYPE=online

# 在线文档编辑版本
VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps
