# 是否打开 mock（对接 nova-auth 时关闭）
VITE_USE_MOCK = false

# 发布路径
VITE_PUBLIC_PATH = /

# 跨域代理：统一走网关
# 约定：前端请求 /api/**  ->  Spring Cloud Gateway (默认 8080)
# 网关再按路径转发到 nova-auth / nova-system / nova-file 等
# 示例路由规划（后端落地后对齐）：
#   /api/auth/**    -> nova-auth
#   /api/system/**  -> nova-system
#   /api/file/**    -> nova-file
VITE_PROXY = [["/api","http://localhost:8080"],["/upload","http://localhost:8080"],["/ws","http://localhost:8080"]]

# 后台接口全路径地址（必填，用于文件预览、WS 等）
VITE_GLOB_DOMAIN_URL=http://localhost:8080

# 后台接口父地址（必填，开发走代理前缀）
VITE_GLOB_API_URL=/api

# 接口前缀（一般留空；如需 /api/v1 可写 /v1）
VITE_GLOB_API_URL_PREFIX=

# icon 组件的 iconify 图标库：online | local
VITE_GLOB_ICONIFY_USE_TYPE=online

# 在线文档编辑版本：wps | offlineWps | onlyoffice
VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps
