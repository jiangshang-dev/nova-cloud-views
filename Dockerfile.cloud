# 微服务前端镜像：静态资源 + Nginx 反代 Gateway（jeecg-boot-gateway:9999）
# 构建前先执行：pnpm build:dockercloud
FROM registry.cn-hangzhou.aliyuncs.com/dockerhub_mirror/nginx
MAINTAINER jeecgos@163.com
VOLUME /tmp
ENV LANG en_US.UTF-8
RUN echo "server {  \
                      listen       80; \
                      client_max_body_size 100m; \
                      location   /jeecgboot/ { \
                      proxy_pass              http://jeecg-boot-gateway:9999/; \
                      proxy_redirect          off; \
                      proxy_http_version      1.1; \
                      proxy_set_header        Host \$host; \
                      proxy_set_header        X-Real-IP \$remote_addr; \
                      proxy_set_header        X-Forwarded-For \$proxy_add_x_forwarded_for; \
                      proxy_set_header        X-Forwarded-Proto \$scheme; \
                      proxy_set_header        Upgrade \$http_upgrade; \
                      proxy_set_header        Connection \"upgrade\"; \
                      proxy_read_timeout      3600s; \
                      proxy_send_timeout      3600s; \
                  } \
                  # WebSocket / SSE 直连网关（domainUrl 也可用 localhost:9999） \
                  location /websocket/ { \
                      proxy_pass              http://jeecg-boot-gateway:9999/websocket/; \
                      proxy_http_version      1.1; \
                      proxy_set_header        Upgrade \$http_upgrade; \
                      proxy_set_header        Connection \"upgrade\"; \
                      proxy_set_header        Host \$host; \
                      proxy_read_timeout      3600s; \
                  } \
                  #解决Router(mode: 'history')模式下，刷新路由地址不能找到页面的问题 \
                  location / { \
                     root   /var/www/html/; \
                      index  index.html index.htm; \
                      if (!-e \$request_filename) { \
                          rewrite ^(.*)\$ /index.html?s=\$1 last; \
                          break; \
                      } \
                  } \
                  access_log  /var/log/nginx/access.log ; \
              } " > /etc/nginx/conf.d/default.conf \
    &&  mkdir  -p  /var/www \
    &&  mkdir -p /var/www/html

ADD dist/ /var/www/html/
EXPOSE 80
EXPOSE 443
