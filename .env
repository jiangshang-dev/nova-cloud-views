# port
VITE_PORT = 3100

# 网站标题
VITE_GLOB_APP_TITLE = Nova Cloud 管理后台

# 简称，此变量只能是字符/下划线
VITE_GLOB_APP_SHORT_NAME = NovaCloud

# 单点登录服务端地址（预留，对接 CAS/企业 SSO 时填写）
VITE_GLOB_APP_CAS_BASE_URL=

# 是否开启单点登录
VITE_GLOB_APP_OPEN_SSO = false

# 开启微前端模式（默认关闭，需要时再开）
VITE_GLOB_APP_OPEN_QIANKUN=false

# 文件预览地址（对接 nova-file / kkFileView 时填写）
VITE_GLOB_ONLINE_VIEW_URL=

# ---- Nova 微服务对接约定 ----
# 网关统一入口前缀：开发环境走 Vite 代理 /api -> gateway
# 认证：Authorization: Bearer <token> + X-Access-Token（兼容）
# 成功码：code === 200（同时兼容 Jeecg 风格 code === 0）
# 数据字段：优先 data，其次 result
